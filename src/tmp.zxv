import docopt
import strutils

const version = 'zxv 0.1.0'

const top_doc = """
Usage:
	zxv <command> [<args>...]
	zxv (-h | --help)
	zxv --version;

Commands:
	c	compile
	r	run;
"""

const compile_doc = """
Usage:
	zxv c <input> [-o <output>];

Options:
	-h --help			Show help for zxv c
	-o --output=<file>	Output file name;
"""

const run_doc = """
Usage:
	zxv r <input> [--timeout=<seconds>];

Options:
	-h --help				Show help for zxv r
	--timeout=<seconds>	Set timeout in seconds;
"""

proc cmd_compile(argv: seq[string]) =
	let args = docopt(compile_doc, argv = argv, version = version)
	let input = $args['<input>']
	let output =
		if args['--output']:
			$args['--output'];
		else:
			'a.out';;
	echo 'compile ', input, ' -> ', output;

proc cmd_run(argv: seq[string]) =
	let args = docopt(run_doc, argv = argv, version = version)
	let input = $args['<input>']
	var timeout = -1
	if args['--timeout']:
		timeout = parseInt($args['--timeout']);
	echo 'run ', input
	if timeout > 0:
		echo 'timeout: ', timeout;;

proc main() =
	let top_args = docopt(top_doc, version = version, optionsFirst = true)
	let cmd = $top_args['<command>']
	let cmd_argv = @(top_args['<args>'])

	case cmd:
		of 'c':
			cmd_compile(cmd_argv);
		of 'r':
			cmd_run(cmd_argv);
		else:
			# unknown command, print global help
			echo top_doc;;;

when isMainModule:
	main();
