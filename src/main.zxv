import std/[os, strutils, strformat, re]
import utils


# "list" of possible token types
type:
	TokenKind = enum:
		tString,     # '...' or "..."
		tChar,       # c'...' or c"..."
		tComment,    # #... or #[ ... ]#
		tIndenter,   # symbols that increase indent level, :\n or =\n
		tIndent,     # placeholder for tabs/spaces
		tSemi,       # ;#
		tNewline,    # \n
		tSpace,
		tSpecial,    # tmp not other type
		tOther,      # everything else
		tEOF         # not super sure what this was originally used for but also for any leftover text
	;
;
# the token object
type:
	Token = object:
		text: string        # raw text for this token
		kind: TokenKind
	;
;


proc ssplit(str: string, verbose=false, specials = ['c\'*\'', 'c"*"', '\'\'\'', '"""', '#[', ']#', 'type:', 'var:', 'enum:', 'object:', '\\*']): seq[string] =
	#[split a string into a list of individual words and symbols 
		and symbol segments found in specials will be concidered as a single word
		default specials are c'*', c"*", ''', """, #[, ]#, \*
		* means any single char
	]#
	let pattern = re'\w+|\r\n|\n|\s|[^\w\s]'
	var strs: seq[string]  # string sequence
	var skip = 0
	let rstr = re.findall(str, pattern)
	# for each word/symbol in string
	for index, group in pairs(rstr):
		block a:
			if verbose: echo 'group ', index, ': ', group, ', skip: ', skip
			if skip > 0:
				skip -= 1
				continue
			;
			# compare each char to each split special
			if verbose: stdout.write '\tchecking: '
			for special in specials:
				block b:
					if verbose: stdout.write special & ', '
					try:
						let sspecial = re.findall(special, pattern)
						# compare with each word/symbol of special
						for num, seg in sspecial:
							# if special segment is a star, auto match
							if seg == '*':
								continue
							;
							# if they dont match, move on to the next special
							if seg != rstr[index + num]:
								break b
							;
							if verbose: stdout.write 'matched: ', seg
						;
						# if match
						var len = sspecial.len - 1
						if verbose: echo '\n\t', special, ' matched, adding: ', rstr[index..index+len].join('')
						strs.add rstr[index..index+len].join('')
						# echo 'strs: ', strs
						skip += len
						break a
					;
					except IndexDefect:
						discard
					;
				;
			;
			if verbose: echo '\tno match'
			strs.add(group)
		;
	;
	return strs
;

proc tokenize(strs: seq[string], verbose=false): seq[Token] =
	if verbose: echo 'Tokenizing:'
	var tokens: seq[Token]
	var counter = 0
	var in_str = false
	var in_comment = 0

	var tmp: string
	# for each str in strs
	for index, group in pairs(strs):
		if verbose: echo fmt'''group {index}: {group.escape_str()}, in_str: {ord(in_str)}, in_comment: {in_comment}'''

		# deal with strings
		# # not in a comment and str is a quote
		if in_comment == 0 and group in ['\'', '"', '\'\'\'', '"""']:
			# if not in string, enter string and record index and opening quote
			if not in_str:
				counter = index
				tmp = group
				in_str = true
			;
			# if is closing quote, exit string
			elif group == tmp:
				if verbose: echo fmt'joining string from {counter} to {index}'
				tokens.add Token(text: join(strs[counter..index], ''), kind: tString)
				if verbose: echo fmt'    result: {tokens[^1].text.escape_str()}'
				in_str = false
			;
			continue
		;
		# ## if in string, skip rest of code
		elif in_str:
			continue
		;

		# deal with comments
		# # single line comment
		if group == '#' and in_comment == 0:
			counter = index
			in_comment = 1
		;
		elif in_comment == 1:
			if group == '\n':
				if verbose: echo fmt'adding single line comment from {counter} to {index-1}'
				tokens.add Token(text: join(strs[counter..index-1], ''), kind: tComment)  # -1 to not include the newline
				in_comment = 0
				# not contiuing here so the newline gets processed
			;
		;
		# # multiline comment
		else:
			# ## entering comment
			if group == '#[':
				if in_comment == 0:
					counter = index
				;
				in_comment += 2
				continue
			;
			# ## exiting comment
			if group == ']#':
				if in_comment == 0:
					echo 'Warning: unmatched ]#'
				;
				else:
					in_comment -= 2
				;
				if in_comment == 0:
					if verbose: echo fmt'joining comment from {counter} to {index}'
					tokens.add Token(text: join(strs[counter..index], ''), kind: tComment)
				;
				continue
			;
		;
		# # if in comment, skip rest of code
		if in_comment > 0:
			continue
		;

		# deal with other stuff
		# # char
		if group.len > 1 and group[0..1] in ['c\'', 'c"']: #":
			tokens.add Token(text: group.strip(trailing=false, chars={c'c'}), kind: tChar)
		;
		# # indenter
		elif group in ['type:', 'var:', 'enum:', 'object:']:
			tokens.add Token(text: group.strip(false, chars={c':'}), kind: tIndenter)
		;
		# # semicolon/de indenter
		elif group == ';':
			tokens.add Token(text: group, kind: tSemi)
		;
		# # newline
		elif group == '\n':
			tokens.add Token(text: group, kind: tNewline)
			tokens.add Token(kind: tIndent)  # placeholder that `indent` can modify later
		;
		# # don't "save" existing indentation
		elif group == '\t' or group == ' ' and tokens[^1].kind == tIndent:
			discard
		;
		# # space (but not indent)
		elif group == ' ':
			tokens.add Token(text: group, kind: tSpace)
		;
		# # special words/symbols, to be processed later
		elif group in [':', '=', 'r', 're']:
			tokens.add Token(text: group, kind: tSpecial)
		;
		# # other, not a special str
		else:
			tokens.add Token(text: group, kind: tOther)
		;
	;
	# if were still in string or comment, add the rest of the text and warn
	if in_comment != 0:
		echo 'Warning: unmatched #['
		tokens.add Token(text: join(strs[counter..^1], ''), kind: tEOF)
	;
	elif in_str:
		echo 'Warning: unmatched ', tmp
		tokens.add Token(text: join(strs[counter..^1], ''), kind: tEOF)
	;
	else:
		tokens.add Token(kind: tEOF)
	;

	# deal with special tokens
	for num1, token in mpairs tokens:
		var num2 = num1
		# : or = followed by comment or newline should be an indenter
		if token.kind == tSpecial and token.text in [':', '=']:
			# "ignore"/skip spaces
			while tokens[num2 + 1].kind == tSpace:
				num2 += 1
			;
			# then check if next token is comment or newline, no need to worry about index error since ends with tEOF
			if tokens[num2 + 1].kind in [tComment, tNewline, tEOF]:
				token.kind = tIndenter
			;
		;
	;

	return tokens
;

proc indent(tokens: var seq[Token], verbose=false, indentation = '  ') =
	if verbose: echo 'Indenting:'
	var indent_level = 0
	if verbose: debugEcho ''
	for num, group in mpairs tokens:
		if verbose: debugEcho 'processing group: ', group.text.escape_str(), ', indent_level: ', indent_level, ', tkind: ', $group.kind
		# add indentation if not blank line
		if group.kind == tIndent and tokens[num + 1].kind != tNewline:
			group.text = repeat(indentation, indent_level)
		;
		elif group.kind == tIndenter:
			indent_level += 1
		;
		elif group.kind == tSemi:
			if indent_level > 0:
				indent_level -= 1
			;
			else:
				echo 'Warning: de-indenting below 0'
			;
		;
	;
	if indent_level != 0:
		echo 'Warning: mismatched =/:'
	;
;
proc indent(tokens: seq[Token], verbose=false, indentation = '  '): seq[Token] =
	var new_tokens = tokens
	indent(new_tokens, verbose, indentation)
	return new_tokens
;

proc transform_string(tokens: var seq[Token], verbose=false) =
	#[
		c''' -> '\''

		'' -> ""
		'"' -> "\""

		'''''' -> """"""
		'''"''' -> """\""""
		'''""''' -> """\"\""""
		'''"""''' -> """\""\""""
	]#
	if verbose: echo 'Transforming strings:'
	for group in mitems tokens:
		#if verbose and group.kind in {tString, tChar}: echo 'transforming: ', group.text.escape_str()
		# characters
		if group.kind == tChar:
			if group.text.len > 3:
				echo 'Warning: too long char: ', group.text
			;
			# set quotes to " and escape inner "
			let inner = group.text[1..^2].replace('"', '\\"')  # using extra inner var since formatting fmt'' not yet implemented
			group.text = "'" & inner & "'"
		;
		# strings
		if group.kind == tString:
			let regex = re(r'(?<!\\)(?:\\\\)*\K' & '"')  # matches all " with even # of preceding \, using & since wrapper auto escapes ", TODO: replace with raw "" once its supported
			# multiline strings
			if group.text.len >= 3 and group.text[0..2] in ['\'\'\'', '"""']:
				if verbose: debugEcho '\ttransforming multiline string: ', group.text.escape_str()
				# set quotes to """ and escape inner """
				let inner = group.text[3..^4].replace(regex, '\\"')
				group.text = '"""' & inner & '"""'
			;
			# regular strings
			else:
				if verbose: debugEcho '\ttransforming string: ', group.text.escape_str()
				# if is empty string
				if group.text.len <= 2:
					group.text = group.text.replace('\'', '"')
				;
				# set quotes to " and escape inner "
				else:
					let inner = group.text[1..^2].replace(regex, '\\"')
					group.text = '"' & inner & '"'
				;
			;
		;
	;
;
proc transform_string(tokens: seq[Token], verbose=false): seq[Token] =
	var new_tokens = tokens
	transform_string(new_tokens, verbose)
	return new_tokens
;

proc untokenize(tokens: seq[Token], verbose=false): string =
	if verbose: echo 'Untokenizing'
	result = ''
	for tok in tokens:
		if tok.kind != tSemi:
			result.add(tok.text)
		;
	;
	return result
;


proc main(file: string, output = '', verbose=false) =
	# load code
	var code = readFile file

	# process code
	var scode = code.ssplit verbose
	# if code doesn't have trailing newline, add one
	if scode.len != 0 and scode[^1] != '\n':
		scode.add '\n'
	;
	# tokenize code
	let tokens = scode.tokenize verbose
	# indent code
	let indented = tokens.indent verbose
	# transform strings
	let transformed = indented.transform_string verbose
	# untokenize code
	code = transformed.untokenize verbose

	# save code, TODO: if output exists and is folder, save to inside folder, if output exists and is file, warn maybe
	if output == '':
		writeFile file.replace('.zxv', '.nim'), code
	;
	elif output.dir_exists or (not output.file_exists and output.endsWith('/')):
		createDir output
		writeFile output / file.split('/')[^1].split('\\')[^1].replace('.zxv', '.nim'), code
	;
	else:
		writeFile output, code
	;
;


proc format*(input: string, output = '', verbose=false) = 
	echo 'format, ' & input & ', ' & output & ', ' & $verbose
;
proc compile*(input: string, output = '', tmp_folder='', verbose=false) = 
	echo 'compile, ' & input & ', ' & output & ', ' & tmp_folder & ', ' & $verbose
;
proc run*(input: string, output = '', tmp_folder='', verbose=false) = 
	echo 'run, ' & input & ', ' & output & ', ' & tmp_folder & ', ' & $verbose
;
proc convert*(input: string, output = '', format='nim', tmp_folder='', verbose=false) = 
	main input, output, verbose
;


when isMainModule:
	echo 'Starting:'
	main 'tests/test.zxv'
;

