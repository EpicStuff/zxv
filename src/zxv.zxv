import std/[os, strutils, strformat]
import docopt
import main


# forward declarations
proc format(command: Value)
proc compile(command: Value)
proc run(command: Value)
proc convert(command: Value)


const version = '0.0.1'

proc main() =
	const doc = '''
zxv
a basic desc of zxv.

Usage:
	zxv <command> [<args>...]
	zxv -h, --help
	zxv --version

Commands:
	format, f   [-v] <input> [-o <output>]
	compile, c  [-v] [-t <folder>] <input> [-o <output>] [-- <args>...]
	run, r      [-v] [-t <folder>] <input> [-o <output>] [-- <args>...]
	convert, C  [-v] [-f <format>] [-t <folder>] <input> [-o <output>] [-- <args>...]

Options:
	-h, --help                 Show this.
	--version                  Show version.
	-v, --verbose              Enable verbose output.
	-o, --output <output>      Specify output file.
	-t, --tmp_folder <folder>  Specify temporary folder. [default: {temp}]
	-f, --format <format>      Specify output format. [default: nim]

Arguments after -- are passed onto nim.
	'''#.replace('\t', '  ').dedent().strip(false)
	let doc_short = doc.split('Options:')[0].strip(false)
	# if no args, print full help and exit cleanly
	if commandLineParams().len == 0:
		echo doc_short
		quit 0
	;
	# else
	let args = docopt(doc, version=version, options_first=true) 
	#echo args

	case $args['<command>']:
		of 'f', 'format': format args['<command>']
		of 'c', 'compile': compile args['<command>']
		of 'r', 'run': run args['<command>']
		of 'C', 'convert': convert args['<command>']
		else:
			echo 'Unknown command: ' & $args['<command>']
			echo doc_short
		;
	;
;

proc format(command: Value) =
	let doc = fmt'''
format zxv input

Usage:
	zxv {command} [-v] <input> [-o <output>]
	zxv {command} -h, --help

Options:
	-h, --help             Show this.
	-v, --verbose          Enable verbose output.
	-o, --output <output>  Specify output file.
	'''#.replace('\t', '  ').dedent().strip(false)

	let args = docopt doc
	format $args['<input>'], $args['--output'], args['--verbose']
;
proc compile(command: Value) =
	let doc = fmt'''
compile input

Usage:
	zxv {command} [-v] <input> [-o <output>] [-t <folder>] [-- <args>...]
	zxv {command} -h, --help

Options:
	-h, --help         Show this.
	-v, --verbose      Enable verbose output.
	-o, --output <output>       Specify output file.
	-t <folder>, --tmp_folder <folder>  Specify temporary folder. [default: {getTempDir()}]

Arguments after -- are passed onto nim.
	'''#.replace('\t', '  ').dedent().strip(false)
	
	let args = docopt doc
	compile $args['<input>'], $args['--output'], $args['--tmp_folder'], args['--verbose']
;
proc run(command: Value) =
	let doc = fmt'''
compile to tmp folder then run input

Usage:
	zxv {command} [-v] <input> [-t <folder>] [-o <output>] [-- <args>...]
	zxv {command} -h, --help    Show extended help.

Options:
	-h, --help                  Show this.
	-v, --verbose               Enable verbose output.
	-o, --output <output>       Specify output file.
	-t, --tmp_folder <folder>   Specify temporary folder. [default: {getTempDir()}]

Arguments after -- are passed onto nim.
	'''#.replace('\t', '  ').dedent().strip(false)

	let args = docopt doc
	run $args['<input>'], $args['--output'], $args['--tmp_folder'], args['--verbose']
;
proc convert(command: Value) =
	let doc = fmt'''
convert input to another format

Usage:
	zxv {command} [-v] <input> [-f <format>] [-t <folder>] [-o <output>] [-- <args>...]
	zxv {command} -h, --help

Options:
	-h, --help                 Show this.
	-v, --verbose              Enable verbose output.
	-o, --output <output>      Specify output file.
	-f, --format <format>      Specify output format. [default: nim]
	-t, --tmp_folder <folder>  Specify temporary folder. [default: {getTempDir()}]

Arguments after -- are passed onto nim.
	'''#.replace('\t', '  ').dedent().strip(false)

	let args = docopt doc
	convert $args['<input>'], $args['--output'], $args['--format'], $args['--tmp_folder'], args['--verbose']
;


when isMainModule:
	main()
;
