# p.run()



import argparse

const version = '0.0.1'

template compile_command(name: string) =
	command(name):
		help 'Compile zxv source file'
		arg 'input'
		# flag '-v' '--verbose' help='Enable verbose output'
		run:
			echo(opts.input)
		;
	;
;


var p = newParser:
	# global options
	# flag('-v', '--verbose', help='Enable verbose output.')
	option('-o', '--output', help='Specify output file.')
	option('-t', '--tmp_folder', help='Specify temporary folder.')
	flag('--version', help='Show version and exit.')

	# zxv c | compile <input> [options]
	compile_command 'compile'
	compile_command 'c'
;

when isMainModule:
	p.run()
