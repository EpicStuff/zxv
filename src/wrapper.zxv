#[
	this is a "compiler" for my "custom" language which I am calling zxv for now
	it's basically nim but with a few styles changes to match my preference

	Usage:
		- `wrapper.zxv c [file]` to compile a file
		- `wrapper.zxv -h` to get help  # TODO

	Changes:
		- indents are with tabs instead of spaces (the objectively superior method) not that they matter anymore, see below
		- single quotes and double quotes can both be used for strings, prepend `c` for characters
		- replaces the indentation system a bracket system to avoid the "formatting is my syntax" issue

	Bracket system: (i think theres an official name for this)
		- basically just the normal
		```
		if stuff {
			do something
		} else {
			do other stuff
		}
		``` 
		system but `{` is replace with `:` and `}` is replace with `;`
		- proper indentation with tabs is still recommended
]#

import std/[os, strutils, strformat, osproc]
import argparse

const indentation = '  '


proc ssplit(str: string, specials = ['\\*', '"""', '\'\'\'', '#[', ']#', '\\\'']): seq[string] =
	## split a string into a list of individual letters as strings 
	## and string segment found in special will be concidered as a single "letter"
	## default specials are ''', """, "\"", #[, ]#, \'
	var line: seq[string]
	var skip = 0
	# for each char in string
	for index, char in pairs(str):
		block a:
			#debugEcho index, 'st char, ', char, ', skip: ', skip
			if skip > 0:
				skip -= 1
				continue
			;
			# compare each char to each special
			for special in specials:
				block b:
					#debugEcho '\tchecking: \'', special, '\''
					try:
						# take the first char in special
						for num, spe in special:
							#debugEcho '\t\tmatching: ', spe
							# if special is a star, auto match
							if spe == "*":
								continue
							;
							# if they dont match, move on to the next special
							if spe != str[index + num]:
								break b
							;
						;
						# if match
						#debugEcho '\tmatch'
						var len = special.len - 1
						line.add(str[index..index+len])
						skip += len
						break a
					;
					except IndexDefect:
						discard
					;
				;
			;
			#debugEcho '\tno match'
			line.add($char)
		;
	;
	return line
;



# get command line parameters
var params = commandLineParams()

# loop through command line parameters
var file: string
var verbose = false
var compile = false

for num, param in params:
	if param == '-v' or param == '--verbose':
		verbose = true
	;
	elif param == '-c' or param == '--compile':
		compile = true
	;
	elif param[0] != "-":
		if file.len == 0:
			file = param
		;
	;
;

# chech for input file
if file.len == 0:
	echo 'no input file specified'
	quit 1
;

# load the code
var code = readFile(file)

# remove trailing whitespace
var old_code = code
while true:
	code = code.replace(' \n', '\n')
	code = code.replace('\t\n', '\n')
	if code == old_code:
		break
	;
	old_code = code
;

# deal with indentation
var indent = 0
var comment = 0
var in_char = false
var in_str = 0  # 0 = not in string, 1 = in string, 2 = 1st line of multiline string, 3 = in multiline string, 4 = end of multiline string, 5 = same line multiline string

var lines = splitLines(code)
for num, lIne in pairs(lines):
	# split string into list of 1 long strings, unless escape character
	var line = ssplit(lIne)
	if verbose: debugEcho 'checking line: ', num, ', ', line
	# skip empty lines
	if line == @[]:
		continue
	;

	## if not in a comment/string block
	# go character by character
	for index, char_group in pairs(line):
		if verbose: debugEcho '\tchecking ', index, 'th char group: ', char_group.replace('\t', '\\t'), '\t\t\t', 'indent: ', indent, ',\tcomment: ', comment, ',\tin char: ', in_char, ',\tin str: ', in_str
		## swap quotes
		# dealing with characters
		if in_char:
			if char_group == '\'':
				line[index] = '\\\''
			;
			in_char = false
			continue
		;
		# if not in a string/char and encounter `"`
		if in_str == 0:
			## deal with comments
			# deal with inline comments, skip rest of line
			if char_group == '#':
				break
			;
			# check if is start of multiline comment (if line, ignoring indentation starts with #[)
			if char_group == '#[':
				comment += 1
				# indent += 1
			;
				# check if is end of multiline comment
			if line[^1] == ']#' and comment > 0:
				comment -= 1
				# indent -= 1
			;
			# if is in a comment block or is a normal line comment, skip
			if comment > 0 or line[0] == '#':
				lines[num] = lines[num].replace('\t', indentation)
				break
			;

			if char_group == '"':
				block a:
					# if is "\"" or """
					try:
						if char_group == '"\\""' or char_group == '"""':
							# replace with '\''
							line[index] = '\'\\\'\''
							break a
						;
					;
					except IndexDefect:
						discard
					;
					# elif is ""
					try:
						if char_group == '""':
							raise newException(ValueError, fmt'empty char detected (and is not allowed), line: {num + 1}, char: {index + 1}')
						;
					;
					except IndexDefect:
						discard
					;
					# else, replace " with '
					line[index] = '\''
					in_char = true
				;
			;
			# dealing with strings
			if char_group == '\'':
				if verbose: debugEcho '\t\treplacing char group with "'
				line[index] = '"'
				in_str = 1
			;
			# tmp multiline string support
			elif char_group == '\'\'\'':
				if verbose: debugEcho '\t\treplacing char group with """'
				line[index] = '"""'
				in_str = 2
			;
		;
		elif in_str == 1:
			# if " in string, escape it
			if char_group == '"':
				if verbose: debugEcho '\t\treplacing char group with \\"'
				line[index] = '\\"'
			;
			# if """ in string, escape it (\"\"\")
			elif char_group == '"""':
				line[index] = '\\"\\"\\"'
			;
			# if "\"" in string, escape it (\"\\\"\")
			elif char_group == '"\\""':
				line[index] = '\\"\\\\\\"\\"'
			;
			# if \' in string, remove unesseary escape
			elif char_group == '\\\'':
				if verbose: debugEcho '\t\treplacing char group with \''
				line[index] = '\''
			;

			# if ' in a string and is not escaped, swap and escape it, and exit string
			if char_group == '\'':
				line[index] = '"'
				in_str = 0
			;
		;
		# tmp multiline string support, in_str == 2 or 3
		else:
			if char_group == '\'\'\'':
				if verbose: debugEcho '\t\treplacing char group with """'
				line[index] = '"""'
				if in_str == 3:
					in_str = 4
				;
				else:
					in_str = 5
				;
			;
			else:
				continue
			;
		;
	;

	## deal with indentation
	if verbose: debugEcho ''
	if in_str notin [3, 4]:
		# remove existing indentation
		#if verbose: echo '\tremoving indentation:'
		for index, char_group in pairs(line):
			#if verbose: echo '\t\tchecking ', index, 'th char group: ', char_group.replace('\t', '\\t')
			if char_group in @[' ', '\t']:
				#if verbose: echo '\t\t\tindent found, char_group: ', char_group.replace('\t', '\\t')
				line[index] = ''
			;
			else:
				#if verbose: echo '\t\t\tindent not found, char_group: ', char_group.replace('\t', '\\t')
				break
			;
		;
		# add indentation
		line[0] = repeat(indentation, indent) & line[0]
		# check for dedentation
		if line[^1] == ':' or line[^1] == '=':
			if comment == 0:
				indent += 1
			;
		;
		for index in countdown(line.len - 1, 0):
			if line[index] == '':
				if verbose: debugEcho ', break'
				break
			;
			if verbose: stdout.write '\tchecking index: ', index, ', char: ', line[index][^1]
			if line[index][^1] == ";":
				line[index] = ''
				if indent > 0 and comment == 0:
					indent -= 1
				;
				if verbose: debugEcho ', dedenting, indent: ', indent
			;
			else:
				if verbose: debugEcho ', break'
				break
			;
		;
	;
	lines[num] = line.join()
	
	# tmp multiline string support
	if in_str == 2:
		in_str = 3
	;
	elif in_str in [4, 5]:
		in_str = 0
	;
;

# save the code
# writeFile(file.replace('.zxv', '.nim'), lines.join('\n'))
file = file.replace('src/', 'build/').replace('.zxv', '.nim')
echo 'saving to: ', file.split('/')[0..^2].join('/')
try:
	createDir file.split('/')[0..^2].join('/')
;
except OSError:
	discard
;
echo 'saving to ', file
writeFile file, lines.join('\n')

if compile:
	discard execShellCmd 'nim c --styleCheck:usages ' & file
;
